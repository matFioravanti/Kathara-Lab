#!/bin/sh
set -eu

pid_file="/run/http-capture.pid"
capture_file="/shared/http.pcap"
log_file="/var/log/http-capture.log"

if [ -r "$pid_file" ]; then
    old_pid="$(cat "$pid_file")"
    if kill -0 "$old_pid" 2>/dev/null; then
        echo "HTTP capture is already running with PID $old_pid."
        exit 0
    fi
    rm -f "$pid_file"
fi

mkdir -p /shared
rm -f "$capture_file"

tcpdump \
    -i any \
    -U \
    -n \
    -s 0 \
    -Z root \
    -w "$capture_file" \
    'arp or tcp port 80' \
    </dev/null >>"$log_file" 2>&1 &

capture_pid="$!"
echo "$capture_pid" >"$pid_file"

sleep 1
if ! kill -0 "$capture_pid" 2>/dev/null; then
    echo "tcpdump did not remain running; inspect $log_file." >&2
    exit 1
fi

echo "Capturing ARP and HTTP traffic to $capture_file (PID $capture_pid)."
