#!/bin/sh
# root: eth0=root-child1, eth1=root-child2, eth2=root-lan
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip addr add 10.0.1.1/30 dev eth0
ip -6 addr add fd00:1::1/64 dev eth0
ip addr add 10.0.2.1/30 dev eth1
ip -6 addr add fd00:2::1/64 dev eth1
ip addr add 192.168.10.1/24 dev eth2
ip -6 addr add fd00:10::1/64 dev eth2

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

# Explicit routes to both child LANs.
ip route add 192.168.20.0/24 via 10.0.1.2 dev eth0
ip -6 route add fd00:20::/64 via fd00:1::2 dev eth0
ip route add 192.168.30.0/24 via 10.0.2.2 dev eth1
ip -6 route add fd00:30::/64 via fd00:2::2 dev eth1
