#!/bin/sh
# child2: eth0=root-child2, eth1=child2-lan
ip link set eth0 up
ip link set eth1 up
ip addr add 10.0.2.2/30 dev eth0
ip -6 addr add fd00:2::2/64 dev eth0
ip addr add 192.168.30.1/24 dev eth1
ip -6 addr add fd00:30::1/64 dev eth1

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

# Both families use the root router as the default next hop.
ip route add default via 10.0.2.1 dev eth0
ip -6 route add default via fd00:2::1 dev eth0
