#!/bin/sh
# Child router 1: eth0 to r0, eth1 to its local LAN.
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

ip addr add 10.0.1.2/30 dev eth0
ip -6 addr add 2001:db8:1::2/64 dev eth0
ip addr add 192.168.20.1/24 dev eth1
ip -6 addr add 2001:db8:20::1/64 dev eth1

# All remote networks are reached through the root router.
ip route add default via 10.0.1.1
ip -6 route add default via 2001:db8:1::1
