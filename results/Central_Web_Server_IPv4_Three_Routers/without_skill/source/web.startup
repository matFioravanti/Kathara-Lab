#!/bin/sh
# HTTP server host.  The document and service are recreated deterministically
# whenever the lab starts, so the node is self-contained and repeatable.
ip addr flush dev eth0
ip addr add 192.168.30.80/24 dev eth0
ip link set eth0 up
ip route replace default via 192.168.30.1 dev eth0

mkdir -p /var/www/html
cat > /var/www/html/index.html <<'EOF'
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Kathara static-routing lab</title></head>
<body><h1>HTTP service reachable through three routers</h1><p>IPv4 static routing is working.</p></body>
</html>
EOF

# kathara/base includes BusyBox; keep one foreground-owned service process
# detached from the startup shell.  Restarting is harmless if the script is
# invoked again on an already-running node.
pkill -f 'httpd -f -p 80' 2>/dev/null || true
busybox httpd -f -p 80 -h /var/www/html >/var/log/httpd.log 2>&1 &
