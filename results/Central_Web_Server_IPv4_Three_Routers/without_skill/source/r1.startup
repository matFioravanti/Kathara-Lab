#!/bin/sh
# Left edge router
ip addr flush dev eth0
ip addr flush dev eth1
ip addr add 192.168.10.1/24 dev eth0
ip addr add 10.0.12.1/30 dev eth1
ip link set eth0 up
ip link set eth1 up
sysctl -w net.ipv4.ip_forward=1
# All remote traffic is sent toward the middle router.
ip route replace default via 10.0.12.2 dev eth1
