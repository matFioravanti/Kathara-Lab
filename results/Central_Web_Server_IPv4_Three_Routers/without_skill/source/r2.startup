#!/bin/bash
set -eu

ip link set eth0 up
ip link set eth1 up
ip addr add 10.0.12.2/30 dev eth0
ip addr add 10.0.23.1/30 dev eth1
sysctl -w net.ipv4.ip_forward=1

# Static routes to the two edge LANs.
ip route add 192.168.10.0/24 via 10.0.12.1 dev eth0
ip route add 192.168.30.0/24 via 10.0.23.2 dev eth1
