#!/bin/sh
ip link set lo up
ip link set eth0 up
ip link set eth1 up
ip addr add 192.168.30.1/24 dev eth0
ip addr add 10.0.23.2/30 dev eth1
ip -6 addr add 2001:db8:30::1/64 dev eth0
ip -6 addr add 2001:db8:23::2/64 dev eth1
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip route add 192.168.10.0/24 via 10.0.23.1
ip route add 192.168.20.0/24 via 10.0.23.1
ip route add default via 10.0.23.1
ip -6 route add 2001:db8:10::/64 via 2001:db8:23::1
ip -6 route add 2001:db8:20::/64 via 2001:db8:23::1
ip -6 route add default via 2001:db8:23::1
