#!/bin/sh
set -eu

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

ip addr add 10.255.23.2/30 dev eth0
ip -6 addr add 2001:db8:10:23::2/64 dev eth0
ip addr add 10.10.3.1/24 dev eth1
ip -6 addr add 2001:db8:10:3::1/64 dev eth1

ip route add default via 10.255.23.1
ip -6 route add default via 2001:db8:10:23::1
