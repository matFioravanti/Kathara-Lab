#!/bin/sh
set -eu

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

ip addr add 10.10.1.1/24 dev eth0
ip -6 addr add 2001:db8:10:1::1/64 dev eth0
ip addr add 10.255.12.1/30 dev eth1
ip -6 addr add 2001:db8:10:12::1/64 dev eth1

ip route add default via 10.255.12.2
ip -6 route add default via 2001:db8:10:12::2
