#!/bin/bash
ip addr add 192.168.4.80/24 dev eth0
ip route add default via 192.168.4.1
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y python3
mkdir -p /var/www/research
printf '<!doctype html><title>research.org</title><h1>research.org web server</h1>\n' > /var/www/research/index.html
nohup python3 -m http.server 80 --bind 192.168.4.80 --directory /var/www/research >/var/log/research-http.log 2>&1 &
