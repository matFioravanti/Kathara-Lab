#!/bin/bash
ip addr add 192.168.4.53/24 dev eth0
ip route add default via 192.168.4.1
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y bind9 dnsutils
cp /shared/bind/named.conf /etc/bind/named.conf
cp /shared/bind/db.research.org /etc/bind/db.research.org
pkill -x named || true
named -c /etc/bind/named.conf
