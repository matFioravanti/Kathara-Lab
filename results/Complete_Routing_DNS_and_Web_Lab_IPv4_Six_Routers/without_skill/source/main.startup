#!/bin/bash
ip addr add 192.168.5.80/24 dev eth0
ip route add default via 192.168.5.1
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y python3
mkdir -p /var/www/main
printf '<!doctype html><title>main.research.org</title><h1>main.research.org server</h1>\n' > /var/www/main/index.html
nohup python3 -m http.server 80 --bind 192.168.5.80 --directory /var/www/main >/var/log/main-http.log 2>&1 &
