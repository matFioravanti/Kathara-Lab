#!/bin/sh

# Dual-stack point-to-point transit link to r1
ip addr flush dev eth0
ip addr add 198.51.100.2/30 dev eth0
ip -6 addr flush dev eth0 scope global
ip -6 addr add 2001:db8:ff::2/64 dev eth0

# LAN 2
ip addr flush dev eth1
ip addr add 203.0.113.1/24 dev eth1
ip -6 addr flush dev eth1 scope global
ip -6 addr add 2001:db8:2::1/64 dev eth1

# Enable forwarding for both address families.
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

# Static routes to LAN 1.
ip route replace 192.0.2.0/24 via 198.51.100.1 dev eth0
ip -6 route replace 2001:db8:1::/64 via 2001:db8:ff::1 dev eth0
