#!/bin/sh
set -eu

sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
sysctl -w net.ipv6.conf.all.accept_ra=0
sysctl -w net.ipv6.conf.default.accept_ra=0

ip link set eth0 up
ip link set eth1 up
ip addr add 192.168.10.1/24 dev eth0
ip addr add 10.0.12.1/30 dev eth1
ip -6 addr add 2001:db8:10::1/64 dev eth0
ip -6 addr add 2001:db8:12::1/64 dev eth1

ip route add 192.168.20.0/24 via 10.0.12.2
ip -6 route add 2001:db8:20::/64 via 2001:db8:12::2
