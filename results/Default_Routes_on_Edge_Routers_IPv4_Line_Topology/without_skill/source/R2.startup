#!/bin/sh

ip addr add 192.168.20.1/24 dev eth0
ip addr add 10.0.12.2/30 dev eth1
ip addr add 10.0.23.1/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
sysctl -w net.ipv4.ip_forward=1

# R2 is an interior router: one explicit route for each remote LAN.
ip route add 192.168.10.0/24 via 10.0.12.1 dev eth1
ip route add 192.168.30.0/24 via 10.0.23.2 dev eth2
ip route add 192.168.40.0/24 via 10.0.23.2 dev eth2
