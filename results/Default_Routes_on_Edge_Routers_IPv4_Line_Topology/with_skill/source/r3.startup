#!/bin/sh
set -eu

sysctl -w net.ipv4.ip_forward=1
ip address replace 192.168.30.1/24 dev eth0
ip address replace 10.0.23.2/30 dev eth1
ip address replace 10.0.34.1/30 dev eth2

# Specific routes only: R3 intentionally has no default route.
ip route replace 192.168.10.0/24 via 10.0.23.1 dev eth1
ip route replace 192.168.20.0/24 via 10.0.23.1 dev eth1
ip route replace 192.168.40.0/24 via 10.0.34.2 dev eth2
