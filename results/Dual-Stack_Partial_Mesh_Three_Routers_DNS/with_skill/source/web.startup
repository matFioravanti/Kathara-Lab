#!/bin/sh
ip addr add 192.168.20.80/24 dev eth0
ip -6 addr add 2001:db8:20::80/64 dev eth0
ip route add default via 192.168.20.1
ip -6 route add default via 2001:db8:20::1
rm -f /etc/apache2/sites-enabled/000-default.conf
ln -sf /etc/apache2/sites-available/company.test.conf /etc/apache2/sites-enabled/company.test.conf
systemctl restart apache2
