#!/bin/sh
ip addr add 10.0.12.1/30 dev eth0
ip -6 addr add 2001:db8:12::1/64 dev eth0
ip addr add 10.0.13.1/30 dev eth1
ip -6 addr add 2001:db8:13::1/64 dev eth1
ip addr add 192.168.10.1/24 dev eth2
ip -6 addr add 2001:db8:10::1/64 dev eth2
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip route add 192.168.20.0/24 via 10.0.12.2
ip route add 192.168.30.0/24 via 10.0.13.2
ip -6 route add 2001:db8:20::/64 via 2001:db8:12::2
ip -6 route add 2001:db8:30::/64 via 2001:db8:13::2
