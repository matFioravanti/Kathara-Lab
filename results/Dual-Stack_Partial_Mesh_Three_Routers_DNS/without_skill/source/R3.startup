#!/bin/sh
ip link set eth0 up; ip link set eth1 up; ip link set eth2 up
ip addr add 10.13.0.2/30 dev eth0; ip -6 addr add 2001:db8:13::2/64 dev eth0
ip addr add 10.23.0.2/30 dev eth1; ip -6 addr add 2001:db8:23::2/64 dev eth1
ip addr add 192.168.3.1/24 dev eth2; ip -6 addr add 2001:db8:3::1/64 dev eth2
sysctl -w net.ipv4.ip_forward=1; sysctl -w net.ipv6.conf.all.forwarding=1
ip route add 192.168.1.0/24 via 10.13.0.1; ip route add 192.168.2.0/24 via 10.23.0.1
ip -6 route add 2001:db8:1::/64 via 2001:db8:13::1; ip -6 route add 2001:db8:2::/64 via 2001:db8:23::1
