#!/bin/sh
# Client LAN: 192.168.10.0/24
ip link set eth0 up
ip addr add 192.168.10.10/24 dev eth0
ip route add 192.168.20.0/24 via 192.168.10.1
ip route add 10.0.0.0/30 via 192.168.10.1
ip route add default via 192.168.10.1

# Use the DNS server on the local LAN for every lookup.
printf 'search service.local\nnameserver 192.168.10.53\noptions ndots:1\n' > /etc/resolv.conf
