#!/bin/sh
set -eu

ip link set eth0 up
ip addr flush dev eth0
ip addr add 192.168.10.53/24 dev eth0
ip route replace default via 192.168.10.1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y bind9 bind9-utils

mkdir -p /etc/bind/zones
cat > /etc/bind/named.conf.options <<'EOF'
options {
        directory "/var/cache/bind";
        listen-on { 127.0.0.1; 192.168.10.53; };
        listen-on-v6 { none; };
        recursion no;
        allow-query { any; };
        dnssec-validation no;
};
EOF

cat > /etc/bind/named.conf.local <<'EOF'
zone "service.local" {
        type master;
        file "/etc/bind/zones/db.service.local";
        allow-transfer { none; };
};
EOF

cat > /etc/bind/zones/db.service.local <<'EOF'
$TTL 300
@       IN      SOA     dns.service.local. admin.service.local. (
                        2026080801 ; serial
                        3600       ; refresh
                        600        ; retry
                        604800     ; expire
                        300 )      ; negative cache TTL
        IN      NS      dns.service.local.
dns     IN      A       192.168.10.53
@       IN      A       192.168.20.80
www     IN      A       192.168.20.80
EOF

named-checkconf
named-checkzone service.local /etc/bind/zones/db.service.local
service bind9 restart
