#!/bin/sh
set -eu

ip link set eth0 up
ip addr flush dev eth0
ip addr add 192.168.20.80/24 dev eth0
ip route replace default via 192.168.20.1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y apache2

cat > /var/www/html/index.html <<'EOF'
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>service.local</title></head>
<body><h1>service.local is reachable</h1><p>This page is served by the web host at 192.168.20.80.</p></body>
</html>
EOF

cat > /etc/apache2/sites-available/service.local.conf <<'EOF'
<VirtualHost *:80>
    ServerName service.local
    ServerAlias www.service.local
    DocumentRoot /var/www/html
    ErrorLog ${APACHE_LOG_DIR}/service.local-error.log
    CustomLog ${APACHE_LOG_DIR}/service.local-access.log combined
</VirtualHost>
EOF

a2dissite 000-default.conf || true
a2ensite service.local.conf
apache2ctl configtest
service apache2 restart
