#!/bin/sh
set -eu
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip addr add 10.0.1.1/30 dev eth0
ip -6 addr add 2001:db8:1::1/64 dev eth0
ip addr add 10.0.2.1/30 dev eth1
ip -6 addr add 2001:db8:2::1/64 dev eth1
ip addr add 10.0.3.1/30 dev eth2
ip -6 addr add 2001:db8:3::1/64 dev eth2
ip addr add 10.0.10.1/24 dev eth3
ip -6 addr add 2001:db8:10::1/64 dev eth3
ip route add 10.1.1.0/24 via 10.0.1.2
ip -6 route add 2001:db8:101::/64 via 2001:db8:1::2
ip route add 10.2.1.0/24 via 10.0.2.2
ip -6 route add 2001:db8:102::/64 via 2001:db8:2::2
ip route add 10.3.1.0/24 via 10.0.3.2
ip -6 route add 2001:db8:103::/64 via 2001:db8:3::2
