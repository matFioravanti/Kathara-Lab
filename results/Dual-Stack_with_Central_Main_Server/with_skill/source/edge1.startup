#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip addr add 10.0.1.2/30 dev eth0
ip -6 addr add fd00:0:1::2/64 dev eth0
ip addr add 10.0.101.1/24 dev eth1
ip -6 addr add fd00:0:101::1/64 dev eth1
ip route add default via 10.0.1.1
ip -6 route add default via fd00:0:1::1
