#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

ip addr add 10.0.1.1/30 dev eth0
ip -6 addr add fd00:0:1::1/64 dev eth0
ip addr add 10.0.2.1/30 dev eth1
ip -6 addr add fd00:0:2::1/64 dev eth1
ip addr add 10.0.3.1/30 dev eth2
ip -6 addr add fd00:0:3::1/64 dev eth2
ip addr add 10.0.10.1/24 dev eth3
ip -6 addr add fd00:0:10::1/64 dev eth3

ip route add 10.0.101.0/24 via 10.0.1.2
ip route add 10.0.102.0/24 via 10.0.2.2
ip route add 10.0.103.0/24 via 10.0.3.2
ip -6 route add fd00:0:101::/64 via fd00:0:1::2
ip -6 route add fd00:0:102::/64 via fd00:0:2::2
ip -6 route add fd00:0:103::/64 via fd00:0:3::2
