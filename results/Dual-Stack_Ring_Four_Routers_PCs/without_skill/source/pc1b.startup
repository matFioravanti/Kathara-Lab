#!/bin/sh
ip addr add 10.10.1.12/24 dev eth0
ip -6 addr add fd00:1::12/64 dev eth0
ip route add 10.10.2.0/24 via 10.10.1.1
ip route add 10.10.3.0/24 via 10.10.1.1
ip route add 10.10.4.0/24 via 10.10.1.1
ip -6 route add fd00:2::/64 via fd00:1::1
ip -6 route add fd00:3::/64 via fd00:1::1
ip -6 route add fd00:4::/64 via fd00:1::1
