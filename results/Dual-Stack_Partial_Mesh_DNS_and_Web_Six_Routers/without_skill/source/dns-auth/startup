#!/bin/sh
ip addr add 192.168.4.53/24 dev eth0
ip -6 addr add 2001:db8:4::53/64 dev eth0
ip route add default via 192.168.4.1
ip -6 route add default via 2001:db8:4::1
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y bind9 dnsutils
cp /shared/named.conf /etc/bind/named.conf
cp /shared/example.net.zone /etc/bind/example.net.zone
named-checkconf /etc/bind/named.conf && named-checkzone example.net /etc/bind/example.net.zone && service bind9 restart
