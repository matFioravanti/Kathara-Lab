#!/bin/bash
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip addr add 10.0.46.2/30 dev eth0
ip -6 addr add fd00:46::2/64 dev eth0
ip addr add 10.0.56.2/30 dev eth1
ip -6 addr add fd00:56::2/64 dev eth1
ip addr add 192.168.6.1/24 dev eth2
ip -6 addr add fd00:6::1/64 dev eth2
ip route replace 192.168.1.0/24 via 10.0.46.1
ip route replace 192.168.2.0/24 via 10.0.46.1
ip route replace 192.168.3.0/24 via 10.0.46.1
ip route replace 192.168.4.0/24 via 10.0.46.1
ip route replace 192.168.5.0/24 via 10.0.56.1
ip -6 route replace fd00:1::/64 via fd00:46::1
ip -6 route replace fd00:2::/64 via fd00:46::1
ip -6 route replace fd00:3::/64 via fd00:46::1
ip -6 route replace fd00:4::/64 via fd00:46::1
ip -6 route replace fd00:5::/64 via fd00:56::1
