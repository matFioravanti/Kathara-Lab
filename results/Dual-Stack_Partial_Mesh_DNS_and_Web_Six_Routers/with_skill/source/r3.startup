#!/bin/bash
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip addr add 10.0.13.2/30 dev eth0
ip -6 addr add fd00:13::2/64 dev eth0
ip addr add 10.0.34.1/30 dev eth1
ip -6 addr add fd00:34::1/64 dev eth1
ip addr add 10.0.35.1/30 dev eth2
ip -6 addr add fd00:35::1/64 dev eth2
ip addr add 192.168.3.1/24 dev eth3
ip -6 addr add fd00:3::1/64 dev eth3
ip route replace 192.168.1.0/24 via 10.0.13.1
ip route replace 192.168.2.0/24 via 10.0.13.1
ip route replace 192.168.4.0/24 via 10.0.34.2
ip route replace 192.168.5.0/24 via 10.0.35.2
ip route replace 192.168.6.0/24 via 10.0.34.2
ip -6 route replace fd00:1::/64 via fd00:13::1
ip -6 route replace fd00:2::/64 via fd00:13::1
ip -6 route replace fd00:4::/64 via fd00:34::2
ip -6 route replace fd00:5::/64 via fd00:35::2
ip -6 route replace fd00:6::/64 via fd00:34::2
