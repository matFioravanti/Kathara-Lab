#!/bin/bash
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
ip addr add 10.0.12.2/30 dev eth0
ip -6 addr add fd00:12::2/64 dev eth0
ip addr add 10.0.24.1/30 dev eth1
ip -6 addr add fd00:24::1/64 dev eth1
ip addr add 192.168.2.1/24 dev eth2
ip -6 addr add fd00:2::1/64 dev eth2
ip route replace 192.168.1.0/24 via 10.0.12.1
ip route replace 192.168.3.0/24 via 10.0.12.1
ip route replace 192.168.4.0/24 via 10.0.24.2
ip route replace 192.168.5.0/24 via 10.0.12.1
ip route replace 192.168.6.0/24 via 10.0.24.2
ip -6 route replace fd00:1::/64 via fd00:12::1
ip -6 route replace fd00:3::/64 via fd00:12::1
ip -6 route replace fd00:4::/64 via fd00:24::2
ip -6 route replace fd00:5::/64 via fd00:12::1
ip -6 route replace fd00:6::/64 via fd00:24::2
