#!/bin/sh
ip addr add 10.0.5.10/24 dev eth0
ip link set eth0 up
ip route add default via 10.0.5.1
mkdir -p /var/www/html
printf '<!doctype html><html><body><h1>kathara.org</h1><p>Static-routing lab web server.</p></body></html>\n' > /var/www/html/index.html
busybox httpd -f -p 80 -h /var/www/html &
