#!/bin/bash
ip link set eth0 up
ip link set eth1 up
ip addr add 10.0.12.2/24 dev eth0
ip addr add 10.0.24.2/24 dev eth1
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.1.0/24 via 10.0.12.1
ip route add 10.0.13.0/24 via 10.0.12.1
ip route add 10.0.34.0/24 via 10.0.24.4
ip route add 10.0.45.0/24 via 10.0.24.4
ip route add 10.0.50.0/24 via 10.0.24.4
ip route add 10.0.60.0/24 via 10.0.24.4
