#!/bin/bash
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip addr add 10.0.45.5/24 dev eth0
ip addr add 10.0.50.1/24 dev eth1
ip addr add 10.0.60.1/24 dev eth2
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.1.0/24 via 10.0.45.4
ip route add 10.0.12.0/24 via 10.0.45.4
ip route add 10.0.13.0/24 via 10.0.45.4
ip route add 10.0.24.0/24 via 10.0.45.4
ip route add 10.0.34.0/24 via 10.0.45.4
