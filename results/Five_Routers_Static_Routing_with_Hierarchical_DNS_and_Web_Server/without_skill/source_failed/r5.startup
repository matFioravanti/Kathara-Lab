#!/bin/sh
ip addr add 10.0.35.2/30 dev eth0
ip addr add 10.0.5.1/24 dev eth1
ip link set eth0 up
ip link set eth1 up
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.12.0/30 via 10.0.35.1
ip route add 10.0.23.0/30 via 10.0.35.1
ip route add 10.0.24.0/30 via 10.0.35.1
ip route add 10.0.1.0/24 via 10.0.35.1
ip route add 10.0.3.0/24 via 10.0.35.1
ip route add 10.0.4.0/24 via 10.0.35.1
