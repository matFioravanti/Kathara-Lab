#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.0.23.2/30 dev eth0
ip addr add 10.0.34.1/30 dev eth1
ip addr add 10.0.30.1/24 dev eth2
ip route add 10.0.1.0/24 via 10.0.23.1
ip route add 10.0.10.0/24 via 10.0.23.1
ip route add 10.0.12.0/30 via 10.0.23.1
ip route add 10.0.45.0/30 via 10.0.34.2
ip route add 10.0.40.0/24 via 10.0.34.2
ip route add 10.0.50.0/24 via 10.0.34.2
