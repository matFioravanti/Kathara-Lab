#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.10.45.2/30 dev eth0
ip addr add 10.10.5.1/24 dev eth1
ip route add 10.10.1.0/24 via 10.10.45.1
ip route add 10.10.12.0/30 via 10.10.45.1
ip route add 10.10.2.0/24 via 10.10.45.1
ip route add 10.10.23.0/30 via 10.10.45.1
ip route add 10.10.3.0/24 via 10.10.45.1
ip route add 10.10.34.0/30 via 10.10.45.1
