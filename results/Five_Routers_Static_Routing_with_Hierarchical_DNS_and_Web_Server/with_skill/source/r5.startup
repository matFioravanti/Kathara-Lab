#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.10.45.2/24 dev eth0
ip addr add 10.10.50.1/24 dev eth1
ip route add 10.10.10.0/24 via 10.10.45.1
ip route add 10.10.12.0/24 via 10.10.45.1
ip route add 10.10.20.0/24 via 10.10.45.1
ip route add 10.10.23.0/24 via 10.10.45.1
ip route add 10.10.30.0/24 via 10.10.45.1
ip route add 10.10.34.0/24 via 10.10.45.1
ip route add 10.10.40.0/24 via 10.10.45.1
