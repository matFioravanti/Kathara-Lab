#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.10.10.1/24 dev eth0
ip addr add 10.10.12.1/24 dev eth1
ip route add 10.10.20.0/24 via 10.10.12.2
ip route add 10.10.23.0/24 via 10.10.12.2
ip route add 10.10.30.0/24 via 10.10.12.2
ip route add 10.10.34.0/24 via 10.10.12.2
ip route add 10.10.40.0/24 via 10.10.12.2
ip route add 10.10.45.0/24 via 10.10.12.2
ip route add 10.10.50.0/24 via 10.10.12.2
