ip addr add 192.168.30.80/24 dev eth0
ip link set eth0 up
ip route add default via 192.168.30.1
mkdir -p /var/www
printf '<!doctype html><title>company.test</title><h1>company.test</h1><p>Authoritative Company web server.</p>\n' > /var/www/index.html
python3 -m http.server 80 --directory /var/www &
