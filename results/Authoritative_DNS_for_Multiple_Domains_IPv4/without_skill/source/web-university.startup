ip addr add 192.168.20.80/24 dev eth0
ip link set eth0 up
ip route add default via 192.168.20.1
mkdir -p /var/www
printf '<!doctype html><title>university.edu</title><h1>university.edu</h1><p>Authoritative University web server.</p>\n' > /var/www/index.html
python3 -m http.server 80 --directory /var/www &
