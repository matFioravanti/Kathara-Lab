ip addr add 10.0.12.1/30 dev eth0
ip addr add 192.168.10.1/24 dev eth1
ip link set eth0 up
ip link set eth1 up
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.23.0/30 via 10.0.12.2
ip route add 10.0.34.0/30 via 10.0.12.2
ip route add 192.168.20.0/24 via 10.0.12.2
ip route add 192.168.30.0/24 via 10.0.12.2
