#!/bin/sh
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip addr add 10.12.0.2/30 dev eth0
ip addr add 10.24.0.1/30 dev eth1
ip addr add 10.2.0.1/24 dev eth2
sysctl -w net.ipv4.ip_forward=1
ip route add 10.1.0.0/24 via 10.12.0.1
ip route add 10.3.0.0/24 via 10.12.0.1
ip route add 10.4.0.0/24 via 10.24.0.2
ip route add 10.5.0.0/24 via 10.24.0.2
ip route add 10.13.0.0/30 via 10.12.0.1
ip route add 10.34.0.0/30 via 10.24.0.2
ip route add 10.45.0.0/30 via 10.24.0.2
