#!/bin/sh
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip addr add 10.4.4.1/24 dev eth0
ip addr add 10.255.24.2/30 dev eth1
ip addr add 10.255.34.2/30 dev eth2
ip addr add 10.255.45.1/30 dev eth3
sysctl -w net.ipv4.ip_forward=1
ip route add 10.1.1.0/24 via 10.255.24.1
ip route add 10.2.2.0/24 via 10.255.24.1
ip route add 10.3.3.0/24 via 10.255.34.1
ip route add 10.5.5.0/24 via 10.255.45.2
ip route add 10.255.12.0/30 via 10.255.24.1
ip route add 10.255.13.0/30 via 10.255.34.1
