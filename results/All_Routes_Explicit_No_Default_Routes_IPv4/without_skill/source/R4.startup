#!/bin/sh
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
ip addr add 10.0.24.2/30 dev eth0
ip addr add 10.0.34.2/30 dev eth1
ip addr add 10.0.45.1/30 dev eth2
ip addr add 192.168.4.1/24 dev eth3
sysctl -w net.ipv4.ip_forward=1
ip route replace 10.0.12.0/30 via 10.0.24.1
ip route replace 10.0.13.0/30 via 10.0.34.1
ip route replace 192.168.1.0/24 via 10.0.24.1
ip route replace 192.168.2.0/24 via 10.0.24.1
ip route replace 192.168.3.0/24 via 10.0.34.1
ip route replace 192.168.5.0/24 via 10.0.45.2
