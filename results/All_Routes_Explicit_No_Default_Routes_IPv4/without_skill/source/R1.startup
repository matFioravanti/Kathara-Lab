#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.disable_ipv6=1
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip addr add 10.0.12.1/30 dev eth0
ip addr add 10.0.13.1/30 dev eth1
ip addr add 192.168.1.1/24 dev eth2
ip route add 192.168.2.0/24 via 10.0.12.2
ip route add 192.168.3.0/24 via 10.0.13.2
ip route add 192.168.4.0/24 via 10.0.12.2
ip route add 192.168.5.0/24 via 10.0.12.2
ip route add 10.0.24.0/30 via 10.0.12.2
ip route add 10.0.34.0/30 via 10.0.13.2
ip route add 10.0.45.0/30 via 10.0.12.2
