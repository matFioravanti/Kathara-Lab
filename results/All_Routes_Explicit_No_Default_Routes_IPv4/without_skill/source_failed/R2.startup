#!/bin/sh
ip addr add 10.0.12.2/30 dev eth0
ip addr add 10.0.24.1/30 dev eth1
ip addr add 10.0.2.1/24 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
sysctl -w net.ipv4.ip_forward=1
ip route replace 10.0.1.0/24 via 10.0.12.1
ip route replace 10.0.3.0/24 via 10.0.12.1
ip route replace 10.0.4.0/24 via 10.0.24.2
ip route replace 10.0.5.0/24 via 10.0.24.2
ip route replace 10.0.13.0/30 via 10.0.12.1
ip route replace 10.0.34.0/30 via 10.0.24.2
ip route replace 10.0.45.0/30 via 10.0.24.2
