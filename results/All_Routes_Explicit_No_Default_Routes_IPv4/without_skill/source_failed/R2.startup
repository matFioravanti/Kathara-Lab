#!/bin/sh
ip addr add 192.168.2.1/24 dev eth0
ip addr add 10.0.12.2/30 dev eth1
ip addr add 10.0.24.1/30 dev eth2
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.13.0/30 via 10.0.12.1
ip route add 10.0.34.0/30 via 10.0.24.2
ip route add 10.0.45.0/30 via 10.0.24.2
ip route add 192.168.1.0/24 via 10.0.12.1
ip route add 192.168.3.0/24 via 10.0.12.1
ip route add 192.168.4.0/24 via 10.0.24.2
ip route add 192.168.5.0/24 via 10.0.24.2
