#!/bin/sh
ip link set lo up
ip addr add 10.0.4.1/24 dev eth0
ip addr add 172.16.24.2/30 dev eth1
ip addr add 172.16.34.2/30 dev eth2
ip addr add 172.16.45.1/30 dev eth3
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up
ip link set eth3 up
sysctl -w net.ipv4.ip_forward=1
ip route add 10.0.1.0/24 via 172.16.24.1
ip route add 10.0.2.0/24 via 172.16.24.1
ip route add 10.0.3.0/24 via 172.16.34.1
ip route add 10.0.5.0/24 via 172.16.45.2
ip route add 172.16.12.0/30 via 172.16.24.1
ip route add 172.16.13.0/30 via 172.16.34.1
