#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr replace 10.1.4.1/24 dev eth0
ip addr replace 10.255.24.2/30 dev eth1
ip addr replace 10.255.34.2/30 dev eth2
ip addr replace 10.255.45.1/30 dev eth3
ip route replace 10.1.1.0/24 via 10.255.24.1 dev eth1
ip route replace 10.1.2.0/24 via 10.255.24.1 dev eth1
ip route replace 10.1.3.0/24 via 10.255.34.1 dev eth2
ip route replace 10.1.5.0/24 via 10.255.45.2 dev eth3
ip route replace 10.255.12.0/30 via 10.255.24.1 dev eth1
ip route replace 10.255.13.0/30 via 10.255.34.1 dev eth2
