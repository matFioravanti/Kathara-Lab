#!/bin/sh
ip addr add 10.1.4.1/24 dev eth0
ip addr add 10.255.24.2/30 dev eth1
ip addr add 10.255.34.2/30 dev eth2
ip addr add 10.255.45.1/30 dev eth3
sysctl -w net.ipv4.ip_forward=1

# Every non-direct IPv4 subnet has an explicit static route.
ip route replace 10.1.1.0/24 via 10.255.24.1
ip route replace 10.1.2.0/24 via 10.255.24.1
ip route replace 10.1.3.0/24 via 10.255.34.1
ip route replace 10.1.5.0/24 via 10.255.45.2
ip route replace 10.255.12.0/30 via 10.255.24.1
ip route replace 10.255.13.0/30 via 10.255.34.1
