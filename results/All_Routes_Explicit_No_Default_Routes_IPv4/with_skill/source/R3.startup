#!/bin/sh
sysctl -w net.ipv6.conf.all.disable_ipv6=1
sysctl -w net.ipv6.conf.default.disable_ipv6=1
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.10.3.1/24 dev eth0
ip addr add 10.255.13.2/30 dev eth1
ip addr add 10.255.34.1/30 dev eth2
ip route replace 10.10.1.0/24 via 10.255.13.1
ip route replace 10.10.2.0/24 via 10.255.13.1
ip route replace 10.10.4.0/24 via 10.255.34.2
ip route replace 10.10.5.0/24 via 10.255.34.2
ip route replace 10.255.12.0/30 via 10.255.13.1
ip route replace 10.255.24.0/30 via 10.255.34.2
ip route replace 10.255.45.0/30 via 10.255.34.2
