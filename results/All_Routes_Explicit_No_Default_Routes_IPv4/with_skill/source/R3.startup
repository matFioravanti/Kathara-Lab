#!/bin/sh
ip addr add 10.10.3.1/24 dev eth0
ip addr add 10.255.13.6/30 dev eth1
ip addr add 10.255.34.13/30 dev eth2
sysctl -w net.ipv4.ip_forward=1

ip route replace 10.10.1.0/24 via 10.255.13.5
ip route replace 10.10.2.0/24 via 10.255.34.14
ip route replace 10.10.4.0/24 via 10.255.34.14
ip route replace 10.10.5.0/24 via 10.255.34.14
ip route replace 10.255.12.0/30 via 10.255.13.5
ip route replace 10.255.24.8/30 via 10.255.34.14
ip route replace 10.255.45.16/30 via 10.255.34.14
