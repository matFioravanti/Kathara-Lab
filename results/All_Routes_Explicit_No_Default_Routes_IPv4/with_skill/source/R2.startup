#!/bin/sh
ip addr add 10.10.2.1/24 dev eth0
ip addr add 10.255.12.2/30 dev eth1
ip addr add 10.255.24.9/30 dev eth2
sysctl -w net.ipv4.ip_forward=1

ip route replace 10.10.1.0/24 via 10.255.12.1
ip route replace 10.10.3.0/24 via 10.255.24.10
ip route replace 10.10.4.0/24 via 10.255.24.10
ip route replace 10.10.5.0/24 via 10.255.24.10
ip route replace 10.255.13.4/30 via 10.255.12.1
ip route replace 10.255.34.12/30 via 10.255.24.10
ip route replace 10.255.45.16/30 via 10.255.24.10
