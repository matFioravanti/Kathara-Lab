#!/bin/sh
ip addr add 10.2.2.1/24 dev eth0
ip addr add 10.255.12.2/30 dev eth1
ip addr add 10.255.24.1/30 dev eth2
sysctl -w net.ipv4.ip_forward=1

# Explicit routes to every non-directly-connected IPv4 subnet.
ip route add 10.1.1.0/24 via 10.255.12.1
ip route add 10.3.3.0/24 via 10.255.12.1
ip route add 10.4.4.0/24 via 10.255.24.2
ip route add 10.5.5.0/24 via 10.255.24.2
ip route add 10.255.13.0/30 via 10.255.12.1
ip route add 10.255.34.0/30 via 10.255.24.2
ip route add 10.255.45.0/30 via 10.255.24.2
