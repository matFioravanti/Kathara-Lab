#!/bin/sh
sysctl -w net.ipv4.ip_forward=1
ip addr add 10.1.5.1/24 dev eth0
ip addr add 172.16.45.2/30 dev eth1
ip route add 10.1.1.0/24 via 172.16.45.1
ip route add 10.1.2.0/24 via 172.16.45.1
ip route add 10.1.3.0/24 via 172.16.45.1
ip route add 10.1.4.0/24 via 172.16.45.1
ip route add 172.16.12.0/30 via 172.16.45.1
ip route add 172.16.13.0/30 via 172.16.45.1
ip route add 172.16.24.0/30 via 172.16.45.1
ip route add 172.16.34.0/30 via 172.16.45.1
