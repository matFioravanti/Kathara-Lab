# IPv4 addresses are assigned to the router interfaces
ip address add 10.0.12.2/30 dev eth0
ip address add 10.0.25.1/30 dev eth1
ip address add 10.10.2.1/24 dev eth2

# IPv4 packet forwarding is enabled
sysctl -w net.ipv4.ip_forward=1

# The static routing table is set
ip route add 10.0.13.0/30 via 10.0.12.1 dev eth0
ip route add 10.0.14.0/30 via 10.0.12.1 dev eth0
ip route add 10.0.35.0/30 via 10.0.25.2 dev eth1
ip route add 10.0.45.0/30 via 10.0.25.2 dev eth1
ip route add 10.10.1.0/24 via 10.0.12.1 dev eth0
ip route add 10.10.3.0/24 via 10.0.12.1 dev eth0
ip route add 10.10.4.0/24 via 10.0.12.1 dev eth0
ip route add 10.10.5.0/24 via 10.0.25.2 dev eth1
