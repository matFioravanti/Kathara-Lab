# IPv4 addresses are assigned to the router interfaces
ip address add 10.0.25.2/30 dev eth0
ip address add 10.0.35.2/30 dev eth1
ip address add 10.0.45.2/30 dev eth2
ip address add 10.10.5.1/24 dev eth3

# IPv4 packet forwarding is enabled
sysctl -w net.ipv4.ip_forward=1

# The static routing table is set
ip route add 10.0.12.0/30 via 10.0.25.1 dev eth0
ip route add 10.0.13.0/30 via 10.0.35.1 dev eth1
ip route add 10.0.14.0/30 via 10.0.45.1 dev eth2
ip route add 10.10.1.0/24 via 10.0.25.1 dev eth0
ip route add 10.10.2.0/24 via 10.0.25.1 dev eth0
ip route add 10.10.3.0/24 via 10.0.35.1 dev eth1
ip route add 10.10.4.0/24 via 10.0.45.1 dev eth2
