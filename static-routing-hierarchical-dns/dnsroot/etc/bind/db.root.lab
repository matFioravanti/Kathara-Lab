$TTL 3600
@   IN SOA a.root.lab. hostmaster.root.lab. (
        2026072901 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        86400      ; negative cache TTL
)
    IN NS a.root.lab.
a.root.lab. IN A 10.10.2.10

org.        IN NS ns.org.
ns.org.     IN A  10.10.3.10
