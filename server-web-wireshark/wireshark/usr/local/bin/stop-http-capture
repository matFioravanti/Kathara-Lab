#!/bin/sh
set -eu

pid_file="/run/http-capture.pid"

if [ ! -r "$pid_file" ]; then
    echo "No HTTP capture PID file was found."
    exit 0
fi

capture_pid="$(cat "$pid_file")"

if kill -0 "$capture_pid" 2>/dev/null; then
    kill -INT "$capture_pid"

    attempts=0
    while kill -0 "$capture_pid" 2>/dev/null && [ "$attempts" -lt 5 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done

    if kill -0 "$capture_pid" 2>/dev/null; then
        echo "Capture process $capture_pid did not stop within five seconds." >&2
        exit 1
    fi
fi

rm -f "$pid_file"
sync /shared/http.pcap 2>/dev/null || sync
echo "Capture stopped and /shared/http.pcap was flushed."
